# Уровень логирования
LOG_LEVEL=INFO

# ==============================================================================
#  ОСНОВНЫЕ НАСТРОЙКИ ТЕЛЕГРАМ-БОТА
# ==============================================================================
# Токен вашего бота, полученный от @BotFather в Telegram
BOT_TOKEN=7123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Ваш цифровой Telegram ID (можно узнать через ботов @userinfobot или @ShowJsonBot)
ADMIN_ID=123456789

# Секретный текстовый код, который обычный пользователь должен ввести при первом входе
ACCESS_CODE=СЕКРЕТНЫЙ_КОД_ДОСТУПА

# Количество пользователей, отображаемых на одной странице в списках админки
ADMIN_USERS_PER_PAGE=10

# ==============================================================================
#  ССЫЛКИ И ВНЕШНИЕ СЕРВИСЫ
# ==============================================================================

# Флаг включения кнопки поддержки (True — включена, False — скрыта)
SUPPORT_BUTTON_ENABLED=True

# Ссылка на аккаунт поддержки или группу (измените на свою)
SUPPORT_LINK=https://t.me/your_support_username


# Ссылка на ваш Telegram-чат поддержки или канал (формат: https://t.me/...)
CHAT_LINK=https://t.me/your_support_chat

# ==============================================================================
#  ИНТЕГРАЦИЯ С ПАНЕЛЬЮ REMNAWAVE
# ==============================================================================
# Полный URL-адрес, по которому доступна ваша панель Remnawave (без косой черты на конце)
REMNAWAVE_BASE_URL=https://panel.example.com

# Секретный API-токен администратора панели для управления пользователями
REMNAWAVE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# UUID отряда (Squad UUID) по умолчанию, в который бот будет автоматически добавлять новых пользователей
REMNAWAVE_DEFAULT_SQUAD_UUID=12345678-abcd-ef01-2345-6789abcdef01

# ==============================================================================
#  ПУТИ К ИЗОБРАЖЕНИЯМ (ОТНОСИТЕЛЬНО КОРНЯ ПРОЕКТА)
# ==============================================================================
# Путь к картинке, которая отправляется вместе с Главным меню
HERO_IMAGE_PATH=assets/main_menu.jpg

# Путь к приветственной картинке на этапе ввода кода доступа
WELCOME_IMAGE_PATH=assets/welcome.jpg

# ==============================================================================
#  ЦЕНОВАЯ ПОЛИТИКА И РЕФЕРАЛЫ
# ==============================================================================

# НАСТРОЙКИ ПРОБНОГО ПЕРИОДА (TRIAL)
TRIAL_DAYS=7
TRIAL_BUTTON_ENABLED=True

# Стоимость тарифа за 1 месяц (в рублях)
PRICE_1=100

# Стоимость тарифа за 3 месяца (в рублях)
PRICE_3=200

# Стоимость тарифа за 6 месяцев (в рублях)
PRICE_6=500

# Стоимость тарифа за 12 месяцев (в рублях)
PRICE_12=1000

# Обязательно ли иметь хотя бы одну оплату для доступа к реферальной программе
# True  — рефералка Скрыта до первой оплаты (поведение для новых пользователей)
# False — рефералка Доступна сразу всем без исключения
REFERRAL_REQUIRE_PAYMENT=True

# Сколько бонусных дней подписки получит пригласивший пользователь после первой оплаты друга
REFERRAL_BONUS_DAYS=5

# ==============================================================================
#  ТЕКСТОВЫЕ БЛОКИ АВТОРИЗАЦИИ
# ==============================================================================
TEXT_ACCESS_PROMPT="🔐 <b>Доступ к боту закрыт</b>\n\nОтправьте <b>код доступа</b>, чтобы открыть меню."
TEXT_ACCESS_SUCCESS="✅ <b>Код принят</b>\n\nДоступ открыт. Загружаю Ваше меню…"
TEXT_ACCESS_ERROR="❌ <b>Неверный код доступа</b>\n\nПроверьте код и попробуйте снова."

# ==============================================================================
#  ГЛАВНОЕ МЕНЮ И РЕФЕРАЛЫ
# ==============================================================================
TEXT_MAIN_MENU="✨ <b>Главное меню</b>\n\n{status_emoji} <b>Статус:</b> {status_text}\n📅 <b>Осталось дней:</b> {days_left}\n🔗 <b>Ссылка на подписку:</b> {sub_url_line}\n💬 <b>Общий чат:</b> {chat_url_line}{admin_line}\n\nИспользуйте кнопки ниже для управления подпиской."
TEXT_REFERRAL_MENU="🤝 <b>Реферальная программа</b>\n\n💰 <b>Вам:</b> +{bonus_days} дн. (после каждой оплаты друга)\n📊 <b>Всего приглашено:</b> {referred_count} чел.\n\n🔗 <b>Ваша ссылка для приглашения:</b>\n<code>{ref_link}</code>"

# ==============================================================================
#  ТАРИФЫ И ОПЛАТА
# ==============================================================================
TEXT_TARIFFS="🧾 <b>Выбор тарифа</b>\n\nВыберите подходящий тариф для продления подписки."

# ==============================================================================
#  НАСТРОЙКА СПОСОБА И ТЕКСТА ОПЛАТЫ
# ==============================================================================
# Бот автоматически переключает режим отображения в зависимости от значения PAYMENT_LINK.
#
# Доступные переменные для подстановки в текст (шаблонизатор):
# {tariff_title} — Название выбранного тарифа (автоматически экранируется)
# {amount}       — Стоимость тарифа в рублях
# {payment_link} — Ссылка на оплату (доступна ТОЛЬКО если PAYMENT_LINK не равен 'none')

# ------------------------------------------------------------------------------
# ВАРИАНТ 1: Оплата по прямой ссылке (СБП, платежная форма, ЮMoney и т.д.)
# ------------------------------------------------------------------------------
PAYMENT_LINK=https://qr.nspk.ru/AD100004BALN8V7C4KN089...
TEXT_TARIFF_PAYMENT="💳 <b>Оплата подписки</b>\n\n📦 <b>Тариф:</b> {tariff_title}\n💰 <b>Сумма:</b> {amount} ₽\n\n🔗 <b>Ссылка на оплату:</b> <a href='{payment_link}'><b>Оплатить через СБП</b></a>\n\nПосле оплаты отправьте <b>скриншот как фото</b>."

